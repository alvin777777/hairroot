generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole
  createdAt    DateTime  @default(now())
  sessions     Session[]
  schedules    Schedule[]
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Schedule {
  id        Int      @id @default(autoincrement())
  name      String
  advisorId Int
  advisor   User     @relation(fields: [advisorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  slots     Slot[]

  @@index([advisorId])
}

model Slot {
  id         Int      @id @default(autoincrement())
  scheduleId Int
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  startAt    DateTime
  endAt      DateTime
  createdAt  DateTime @default(now())

  @@index([startAt])
}
