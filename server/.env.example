# Copy to .env for local development. Never commit .env.
# These are local development values for the Docker database in the README, not real secrets.
DATABASE_URL="postgresql://hairroot:hairroot@localhost:5435/hairroot?schema=public"
PORT=3001
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV=development
# Password for the synthetic demo accounts created by `npm run db:seed`. Choose your own locally;
# in GCP it comes from Secret Manager. Never commit a real value.
SEED_DEMO_PASSWORD="choose-a-local-demo-password"
# true wipes all data before seeding. Local and test databases only; refused when NODE_ENV=production.
SEED_RESET=false
